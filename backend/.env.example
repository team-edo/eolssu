# 참고용 예시이며 Spring Boot가 .env를 자동으로 읽지는 않습니다.
# 실행할 터미널 또는 IDE 실행 설정에서 환경변수로 지정하세요.
SERVER_PORT=8080

# FE 개발 서버처럼 다른 주소에서 쿠키를 포함해 백엔드를 직접 부를 때만 쉼표로 구분해 지정합니다.
# 운영·Nginx 뒤 서버는 비워 둡니다. *는 쓸 수 없습니다(쿠키 허용과 함께 쓰면 오류).
# 예: FE 웹 개발 서버와 함께 개발할 때 SERVER_PORT=8081, SECURITY_ALLOWED_ORIGINS=http://localhost:8080
SECURITY_ALLOWED_ORIGINS=

# DB 기능을 사용할 때만 db 프로필을 활성화합니다. DB는 미리 생성합니다.
SPRING_PROFILES_ACTIVE=db
DB_URL=jdbc:mysql://localhost:3306/eolssu
DB_USERNAME=eolssu
DB_PASSWORD=

# db 프로필 필수. 임의 32바이트 이상을 Base64로 인코딩한 서버 비밀키. 기본값 없음.
# 한 번 발급해 보관하고, 인증번호가 유효한 동안 같은 값을 유지합니다.
AUTH_CODE_HMAC_SECRET=
# HS256 access_token 서명·검증용 UTF-8 비밀키(32바이트 이상). 누락 시 기동하되 가입·로그인·재발급은 503, 모든 토큰은 401.
AUTH_JWT_SECRET=
# 로그인 쿠키 Secure 여부. 기본 true. 로컬 HTTP 개발에서만 false로 둡니다.
AUTH_COOKIE_SECURE=true
# smtp(기본): 아래 HOST·USERNAME·PASSWORD가 모두 있으면 실제 발송, 하나라도 없으면 발송만 거절(가입 503, 재설정·계정 연결은 202).
# memory: 로컬 메모리 대역(실제 이메일 없음). unavailable: 항상 발송 거절.
AUTH_MAIL_MODE=smtp
# 네이버 SMTP(운영 smtp.naver.com, 587). STARTTLS는 설정에 고정. 비밀번호는 네이버 애플리케이션 비밀번호(로그인 비밀번호 아님).
AUTH_MAIL_HOST=
AUTH_MAIL_PORT=587
AUTH_MAIL_USERNAME=
AUTH_MAIL_PASSWORD=
# 비우면 AUTH_MAIL_USERNAME을 발신 주소로, 이름은 생략합니다.
AUTH_MAIL_FROM=
AUTH_MAIL_FROM_NAME=

# 연주 분석 AI 서비스 주소(PRA-03). 비우면 업로드 뒤 분석을 시작하지 않고, 업로드된 세션은 60초 뒤 TIMEOUT이 된다.
# 예: ANALYSIS_AI_BASE_URL=http://localhost:8000
ANALYSIS_AI_BASE_URL=

# 녹음 원본 저장소(S3 호환, Cloudflare R2). 하나라도 비우면 녹음 업로드만 503으로 거절합니다.
# 엔드포인트는 https://<account_id>.r2.cloudflarestorage.com, 키는 버킷 하나에 객체 읽기·쓰기만 허용한 R2 API 토큰의 S3 키입니다.
RECORDING_STORAGE_ENDPOINT=
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_ACCESS_KEY_ID=
RECORDING_STORAGE_SECRET_ACCESS_KEY=
RECORDING_STORAGE_REGION=auto

# 내 악보 생성 M4A·MIDI 저장소(S3 호환, Cloudflare R2). 업로드 원본은 이 버킷에 올리지 않습니다(534).
# 비어 있으면 음원 생성은 503이며 원본 불러오기는 가능합니다. 녹음과 별도 버킷·키를 쓰고 자동 만료 규칙을 두지 않습니다.
SHEET_STORAGE_ENDPOINT=
SHEET_STORAGE_BUCKET=
SHEET_STORAGE_ACCESS_KEY_ID=
SHEET_STORAGE_SECRET_ACCESS_KEY=
SHEET_STORAGE_REGION=auto

# 영구 기본음·시김새 자산 읽기 전용 서명. 녹음 저장소 설정·recordings/ 30일 삭제와 별개입니다.
# reference-audio/v1/ 파일을 보관한 버킷과 읽기 권한 키를 설정합니다. 누락 시 조회는 가능하고 재생만 503입니다.
REFERENCE_AUDIO_STORAGE_ENDPOINT=
REFERENCE_AUDIO_STORAGE_BUCKET=
REFERENCE_AUDIO_STORAGE_ACCESS_KEY_ID=
REFERENCE_AUDIO_STORAGE_SECRET_ACCESS_KEY=
REFERENCE_AUDIO_STORAGE_REGION=auto

# databaseTest 전용. 운영 DB가 아닌 비어 있는 폐기 가능한 MySQL 8.4 DB를 지정합니다.
TEST_DB_URL=jdbc:mysql://localhost:3306/eolssu_test
TEST_DB_USERNAME=eolssu_test
TEST_DB_PASSWORD=

# 운영자가 명시한 테스트 회원 ID만 시간 만료 예외 적용. 기본값은 빈 목록.
AUTH_NON_EXPIRING_USER_IDS=

# Android Studio 테스트 APK의 공개 SHA-256 인증서 지문(쉼표 구분). 미설정 시 assetlinks.json은404.
AUTH_ANDROID_APP_SHA256_FINGERPRINTS=
AUTH_ANDROID_QA_APP_SHA256_FINGERPRINTS=

# 소셜 로그인. 제공자별 ID·secret·허용 콜백 목록 중 하나라도 없으면 해당 제공자만 503입니다.
# 콜백은 앱 콘솔·FE와 합의한 정확한 URI를 쉼표로 구분합니다. 예시 주소를 운영 허용 목록에 넣지 마세요.
AUTH_OAUTH_KAKAO_CLIENT_ID=
# 서명형 User Unlinked 웹훅의 앱 ID. 누락 시 수신만503, 기본 키/ID 없음.
AUTH_KAKAO_WEBHOOK_APP_ID=
AUTH_OAUTH_KAKAO_CLIENT_SECRET=
# 카카오 콘솔 등록 완료 주소: https://eolssu.site/auth/android/oauth/kakao/callback
AUTH_OAUTH_KAKAO_REDIRECT_URIS=
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_REDIRECT_URIS=
AUTH_OAUTH_NAVER_CLIENT_ID=
AUTH_OAUTH_NAVER_CLIENT_SECRET=
AUTH_OAUTH_NAVER_REDIRECT_URIS=

# 악보 인식 내부 서비스. 비우면 신규 업로드·실패 재시도는 503입니다.
SHEET_CONVERSION_OMR_BASE_URL=
# 내 악보 음원 내부 생성기. 비우면 새 생성 요청은 503입니다. 수신 제한은 생성기 90초 + 전송 여유 10초입니다.
# Uploaded originals are temporary and fetched only by OMR over the internal network.
SHEET_IMPORT_READ_BASE_URL=http://backend:8080/api/internal/sheet-imports
SHEET_AUDIO_BASE_URL=
SHEET_AUDIO_TIMEOUT_SECONDS=100
